# OpenKomodoIDE Mozilla Build Configuration
# Firefox 140 ESR based build configuration

# Enable official branding
ac_add_options --enable-official-branding

# Build type (release by default, can be overridden)
ac_add_options --enable-release

# Enable optimization
ac_add_options --enable-optimize

# Disable debug symbols by default (can be enabled via build config)
ac_add_options --disable-debug-symbols

# Enable crash reporter symbols
ac_add_options --with-crashreport-symbols

# Application configuration
ac_add_options --enable-application=komodo
ac_add_options --with-app-name=OpenKomodoIDE
ac_add_options --with-app-version=12.0

# Platform-specific options - these will be set by the build system
# Linux x64 (default)
ac_add_options --target=x86_64-pc-linux-gnu
ac_add_options --enable-default-toolkit=cairo-gtk3
ac_add_options --enable-gtk3
ac_add_options --enable-system-ffi
ac_add_options --enable-system-pixman

# Build options
ac_add_options --enable-jemalloc
ac_add_options --enable-system-sqlite
ac_add_options --enable-system-icu
ac_add_options --enable-system-nspr
ac_add_options --enable-system-nss

# Disable unnecessary components
ac_add_options --disable-updater
ac_add_options --disable-parental-controls
ac_add_options --disable-accessibility-services
ac_add_options --disable-tests

# Enable required features
ac_add_options --enable-extensions=default
ac_add_options --enable-websockets
ac_add_options --enable-gamepad

# Developer options
ac_add_options --enable-developer-tools

# Build configuration
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/build
mk_add_options MOZ_MAKE_FLAGS="-j$(nproc)"

# Environment variables
export MOZILLA_OFFICIAL=1
export MOZ_TELEMETRY_REPORTING=1
export MOZ_ADDON_SIGNING=1
export MOZ_REQUIRE_SIGNING=1

# Firefox 140 ESR specific options
ac_add_options --with-firefox-version=140.0

# Komodo IDE specific options
ac_add_options --enable-komodo-extensions
ac_add_options --enable-python
ac_add_options --enable-perl
ac_add_options --enable-php
ac_add_options --enable-ruby
ac_add_options --enable-nodejs

# Disable unwanted features
ac_add_options --disable-pulseaudio
ac_add_options --disable-dbus
ac_add_options --disable-gconf
