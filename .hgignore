# Mercurial ignore file for Git compatibility
# This file is created to satisfy legacy build system requirements

# Ignore build artifacts
syntax: glob
*.pyc
*.pyo
*.pyd
__pycache__/

# Ignore build directories
build/
dist/
obj-*/

# Ignore logs and temporary files
*.log
*.tmp
*.swp

# Ignore editor files
*.bak
*.orig
*.rej

# Ignore IDE files
.idea/
.vscode/
*.iml

# Ignore dependency directories
node_modules/
venv/
.env/

# Ignore macOS files
.DS_Store

# Ignore Windows files
Thumbs.db
