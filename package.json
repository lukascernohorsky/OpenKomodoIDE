    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "commander": "^10.0.1"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "jest": "^29.7.0",
    "babel-jest": "^29.7.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenKomodo/OpenKomodoIDE.git"
  },
