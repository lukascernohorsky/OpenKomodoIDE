{
  "name": "openkomodoide",
  "version": "12.0.0",
  "description": "OpenKomodoIDE - Komodo IDE based on Firefox 140 ESR",
  "main": "src/main/application/App.js",
  "scripts": {
    "start": "node src/main/application/App.js",
    "build": "python3 build_simple.py simple",
    "build:configure": "python3 build.py configure",
    "build:complete": "python3 build.py complete",
    "build:simple": "python3 build_simple.py simple",
    "build:components": "python3 build_simple.py components",
    "build:package": "python3 build_simple.py package",
    "build:clean": "python3 build.py clean",
    "build:test": "python3 build.py test",
    "test": "python3 test_build.py",
    "lint": "echo 'Lint script will go here'"
