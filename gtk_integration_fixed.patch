--- widget/gtk/moz.build.orig	2024-01-01 00:00:00.000000000 +0000
+++ widget/gtk/moz.build	2024-01-01 00:00:00.000000000 +0000
@@ -192,6 +192,12 @@ if CONFIG["MOZ_WAYLAND"]:
     CXXFLAGS += CONFIG["MOZ_WAYLAND_CFLAGS"]
 
 if CONFIG["MOZ_ENABLE_DBUS"]:
+    # Komodo GTK integration for Firefox 140 ESR
+    if CONFIG['MOZ_KOMODO']:
+        DEFINES['MOZ_KOMODO_GTK'] = True
+        SOURCES += ['komodo/gtk/KomodoGTKIntegration.cpp']
+        EXPORTS += ['komodo/gtk/KomodoGTKIntegration.h']
+        CXXFLAGS += ['-DMOZ_KOMODO_GTK']
+
+    EXPORTS.mozilla.widget += [
         "AsyncDBus.h",
     ]
--- widget/gtk/nsWindow.cpp.orig	2024-01-01 00:00:00.000000000 +0000
+++ widget/gtk/nsWindow.cpp	2024-01-01 00:00:00.000000000 +0000
@@ -6002,6 +6002,12 @@ nsWindow::Create(nsIWidget* aParent,
   // initialize all the common bits of this class
   BaseCreate(aParent, aInitData);
 
+#ifdef MOZ_KOMODO_GTK
+    // Komodo GTK integration for Firefox 140 ESR
+    KomodoGTKIntegration::InitializeWindow(this);
+    mKomodoWindow = new KomodoWindowWrapper(this);
+#endif
+
   LOG("nsWindow::Create()");
 
   // save our bounds
@@ -679,6 +685,12 @@ nsWindow::Destroy()
   if (mRootAccessible) {
     mRootAccessible = nullptr;
   }
 #endif
+
+#ifdef MOZ_KOMODO_GTK
+    // Cleanup Komodo GTK integration
+    KomodoGTKIntegration::CleanupWindow(this);
+    delete mKomodoWindow;
+#endif
 
   // Save until last because OnDestroy() may cause us to be deleted.
   OnDestroy();