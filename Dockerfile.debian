# OpenKomodoIDE Build Environment for Debian
# Based on Debian Bookworm (stable)

FROM debian:bookworm-slim

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install basic system utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    ca-certificates \
    curl \
    wget \
    git \
    mercurial \
    subversion \
    bash-completion \
    locales \
    tzdata \
    procps \
    file \
    vim-tiny \
    less \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Configure locales
RUN sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# Create build user
RUN useradd -m -s /bin/bash builduser && \
    echo "builduser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /home/builduser/build && \
    chown builduser:builduser /home/builduser/build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools \
    build-essential \
    make \
    cmake \
    ninja-build \
    autoconf \
    autoconf2.13 \
    automake \
    libtool \
    pkg-config \
    ccache \
    \
    # Python \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    python3-setuptools \
    python-is-python3 \
    \
    # Version control \
    git \
    mercurial \
    subversion \
    \
    # Development libraries \
    libssl-dev \
    libffi-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libxml2-dev \
    libxslt1-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libdbus-glib-1-dev \
    libasound2-dev \
    libcurl4-openssl-dev \
    libiw-dev \
    libxt-dev \
    mesa-common-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libx11-xcb-dev \
    libxcb-shm0-dev \
    libxcb-render0-dev \
    libxcb-render-util0-dev \
    libxcb-xkb-dev \
    libxcb-icccm4-dev \
    libxcb-image0-dev \
    libxcb-keysyms1-dev \
    libxcb-randr0-dev \
    libxcb-shape0-dev \
    libxcb-sync-dev \
    libxcb-xfixes0-dev \
    libxcb-xinerama0-dev \
    libxcb-dri3-dev \
    libxcb-util-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libpango1.0-dev \
    libgdk-pixbuf2.0-dev \
    \
    # Utilities \
    zip \
    unzip \
    tar \
    gzip \
    bzip2 \
    xz-utils \
    patch \
    diffutils \
    yasm \
    llvm \
    clang \
    && rm -rf /var/lib/apt/lists/*

# Install additional Python packages
RUN python3 -m pip install --upgrade pip setuptools wheel

# Set up working directory
WORKDIR /home/builduser/build

# Set up environment variables
ENV PATH=/home/builduser/.local/bin:/usr/local/bin:/usr/bin:/bin
ENV PYTHONPATH=/home/builduser/build
ENV MOZCONFIG=/home/builduser/build/mozconfig
ENV LD_LIBRARY_PATH=/home/builduser/build/lib
ENV CCACHE_DIR=/home/builduser/.ccache
ENV CCACHE_SLOPPINESS=file_macro,time_macros
ENV CCACHE_MAXSIZE=10G
ENV MAKEFLAGS=-j$(nproc)

# Create ccache directory
RUN mkdir -p /home/builduser/.ccache && \
    chown builduser:builduser /home/builduser/.ccache

# Set up entrypoint
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default command
CMD ["bash"]