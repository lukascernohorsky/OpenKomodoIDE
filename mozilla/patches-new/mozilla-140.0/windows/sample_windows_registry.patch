diff --git a/toolkit/xre/nsWindowsWMain.cpp b/toolkit/xre/nsWindowsWMain.cpp
index abc1234..def5678 100644
--- a/toolkit/xre/nsWindowsWMain.cpp
+++ b/toolkit/xre/nsWindowsWMain.cpp
@@ -56,6 +56,10 @@
 #include "nsWindowsRestart.h"
 #include "mozilla/UniquePtr.h"
 
+#ifdef MOZ_KOMODO
+#include "komodo/WindowsRegistry.h"
+#endif
+
 using namespace mozilla;
 
 int APIENTRY wWinMain(_In_ HINSTANCE hInstance,
@@ -123,6 +127,14 @@ int APIENTRY wWinMain(_In_ HINSTANCE hInstance,
     
     rv = XRE_WinMain(hInstance, hPrevInstance, lpCmdLine, nCmdShow);
     
+#ifdef MOZ_KOMODO
+    // Firefox 140 ESR: Windows-specific Komodo integration
+    if (NS_SUCCEEDED(rv)) {
+      // Clean up Windows registry settings
+      KomodoWindowsRegistry::Cleanup();
+      // Save session data
+      KomodoWindowsRegistry::SaveSession();
+    }
+#endif
     
     return NS_SUCCEEDED(rv) ? 0 : 1;
 }

