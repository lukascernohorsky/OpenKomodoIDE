--- toolkit/xre/nsWindowsWMain.cpp.orig	2024-01-01 00:00:00.000000000 +0000
+++ toolkit/xre/nsWindowsWMain.cpp	2024-01-01 00:00:00.000000000 +0000
@@ -56,6 +56,10 @@
 #include "nsWindowsRestart.h"
 #include "mozilla/UniquePtr.h"
 
+#ifdef MOZ_KOMODO
+#include "komodo/WindowsRegistry.h"
+#include "komodo/WindowsIntegration.h"
+#endif
+
 using namespace mozilla;
 
 int APIENTRY wWinMain(_In_ HINSTANCE hInstance,
@@ -123,6 +127,18 @@ int APIENTRY wWinMain(_In_ HINSTANCE hInstance,
      
     rv = XRE_WinMain(hInstance, hPrevInstance, lpCmdLine, nCmdShow);
     
+#ifdef MOZ_KOMODO
+    // Firefox 140 ESR: Windows-specific Komodo integration
+    if (NS_SUCCEEDED(rv)) {
+      // Initialize Windows integration
+      KomodoWindowsIntegration::Initialize();
+      // Clean up Windows registry settings
+      KomodoWindowsRegistry::Cleanup();
+      // Save session data
+      KomodoWindowsRegistry::SaveSession();
+      // Finalize Windows integration
+      KomodoWindowsIntegration::Finalize();
+    }
+#endif
     return NS_SUCCEEDED(rv) ? 0 : 1;
 }
