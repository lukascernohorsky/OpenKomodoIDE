--- python/mozbuild/mozbuild/backend/confvars.py.orig	2024-01-01 00:00:00.000000000 +0000
+++ python/mozbuild/mozbuild/backend/confvars.py	2024-01-01 00:00:00.000000000 +0000
@@ -45,6 +45,12 @@ def get_define(name):
     return defines.get(name, None)
 
+# Komodo PyXPCOM integration for Firefox 140 ESR
+def is_komodo_enabled():
+    return bool(get_define('MOZ_KOMODO'))
+
+def is_pyxpcom_enabled():
+    return is_komodo_enabled() and bool(get_define('MOZ_PYXPCOM'))
+
 # Original functions continue...
 --- js/xpconnect/src/moz.build.orig	2024-01-01 00:00:00.000000000 +0000
+++ js/xpconnect/src/moz.build	2024-01-01 00:00:00.000000000 +0000
@@ -123,6 +123,12 @@ if CONFIG['MOZ_XPCOM']:
     SOURCES += ['XPCJSRuntime.cpp']
     DEFINES['MOZ_XPCOM'] = True
 
+if CONFIG['MOZ_KOMODO'] and CONFIG['MOZ_PYXPCOM']:
+    DEFINES['MOZ_KOMODO_PYXPCOM'] = True
+    SOURCES += ['komodo/pyxpcom/KomodoPyXPCOM.cpp']
+    EXPORTS += ['komodo/pyxpcom/KomodoPyXPCOM.h']
+    CXXFLAGS += ['-DMOZ_KOMODO_PYXPCOM']
+
 # Original build configuration continues...
 --- dom/bindings/moz.build.orig	2024-01-01 00:00:00.000000000 +0000
+++ dom/bindings/moz.build	2024-01-01 00:00:00.000000000 +0000
@@ -45,6 +45,12 @@ if CONFIG['MOZ_WEBIDL']:
     SOURCES += ['WebIDLGlobalNameHash.cpp']
     DEFINES['MOZ_WEBIDL'] = True
 
+if CONFIG['MOZ_KOMODO'] and CONFIG['MOZ_PYXPCOM']:
+    DEFINES['MOZ_KOMODO_WEBIDL'] = True
+    SOURCES += ['komodo/bindings/KomodoWebIDL.cpp']
+    EXPORTS += ['komodo/bindings/KomodoWebIDL.h']
+    CXXFLAGS += ['-DMOZ_KOMODO_WEBIDL']
+
 # Original WebIDL configuration continues...
 --- toolkit/moz.configure.orig	2024-01-01 00:00:00.000000000 +0000
+++ toolkit/moz.configure	2024-01-01 00:00:00.000000000 +0000
@@ -234,6 +234,12 @@ option('--enable-pyxpcom', env='MOZ_PYXPCOM',
        help='Enable Python XPCOM support')
 
+# Komodo PyXPCOM integration
+if depends('--enable-komodo', '--enable-pyxpcom')(lambda komodo, pyxpcom: komodo and pyxpcom):
+    set_config('MOZ_KOMODO_PYXPCOM', True)
+    set_define('MOZ_KOMODO_PYXPCOM', True)
+    add_old_configure_assignment('MOZ_KOMODO_PYXPCOM', True)
+
 # Original PyXPCOM configuration continues...
 --- xpcom/build/moz.build.orig	2024-01-01 00:00:00.000000000 +0000
+++ xpcom/build/moz.build	2024-01-01 00:00:00.000000000 +0000
@@ -123,6 +123,12 @@ if CONFIG['MOZ_XPCOM']:
     SOURCES += ['XPCOMInit.cpp']
     DEFINES['MOZ_XPCOM'] = True
 
+if CONFIG['MOZ_KOMODO'] and CONFIG['MOZ_PYXPCOM']:
+    DEFINES['MOZ_KOMODO_XPCOM'] = True
+    SOURCES += ['komodo/xpcom/KomodoXPCOM.cpp']
+    EXPORTS += ['komodo/xpcom/KomodoXPCOM.h']
+    CXXFLAGS += ['-DMOZ_KOMODO_XPCOM']
+
 # Original XPCOM configuration continues...