# Komodo application directory configuration

DIRS += [
    'app',
    'config',
]

# Komodo-specific configuration files
CONFIGURE_SUBST_FILES += [
    'confvars.sh',
]

# Komodo branding files
if CONFIG['MOZ_WIDGET_TOOLKIT'] == 'windows':
    DIRS += ['branding/windows']
elif CONFIG['MOZ_WIDGET_TOOLKIT'] == 'gtk':
    DIRS += ['branding/unix']
elif CONFIG['MOZ_WIDGET_TOOLKIT'] == 'cocoa':
    DIRS += ['branding/mac']

# Komodo-specific components
EXTRA_COMPONENTS += [
    'komodo.js',
    'komodo.manifest',
]

# Include application.ini in the build
FINAL_TARGET_FILES.defaults += [
    'app/application.ini',
]

# Komodo-specific modules
EXTRA_JS_MODULES += [
    'komodo.jsm',
]

# Komodo-specific XPCShell tests
XPCSHELL_TESTS_MANIFESTS += ['test/xpcshell.ini']

# Komodo-specific mochitests
MOCHITEST_MANIFESTS += ['test/mochitest.ini']

# Komodo-specific browser chrome tests
BROWSER_CHROME_MANIFESTS += ['test/browser.ini']