# Komodo application configuration

CONFIGURE_SUBST_FILES += [
    'application.ini',
    'profile/komodo.js',
    'profile/prefs.js',
]

FINAL_TARGET_FILES.defaults.preferences += [
    'profile/komodo.js',
    'profile/prefs.js',
]

FINAL_TARGET_FILES.defaults += [
    'application.ini',
]

# Komodo-specific defines
DEFINES['MOZ_APP_NAME'] = 'komodo'
DEFINES['MOZ_APP_DISPLAYNAME'] = 'Komodo IDE'
DEFINES['MOZ_APP_VERSION'] = CONFIG['MOZ_APP_VERSION']
DEFINES['MOZ_APP_ID'] = 'komodo@activestate.com'
DEFINES['MOZ_APP_REMOTINGNAME'] = 'komodo'

# Include the main application build configuration
DIRS += [
    'profile',
]

# Komodo branding
BRANDING_FILES = [
    'komodo.ico',
]

# Application icons
if CONFIG['MOZ_WIDGET_TOOLKIT'] == 'windows':
    RCINCLUDE = 'komodo.rc'
    DEFINES['MOZ_APP_ICON'] = 'komodo.ico'
elif CONFIG['MOZ_WIDGET_TOOLKIT'] == 'gtk':
    DEFINES['MOZ_APP_ICON'] = 'default.xpm'
elif CONFIG['MOZ_WIDGET_TOOLKIT'] == 'cocoa':
    DEFINES['MOZ_APP_ICON'] = 'komodo.icns'

# Komodo-specific components
EXTRA_COMPONENTS += [
    'komodo.js',
    'komodo.manifest',
]

# Komodo-specific modules
EXTRA_JS_MODULES += [
    'komodo.jsm',
]

# Komodo-specific XPCShell tests
XPCSHELL_TESTS_MANIFESTS += ['test/xpcshell.ini']

# Komodo-specific mochitests
MOCHITEST_MANIFESTS += ['test/mochitest.ini']

# Komodo-specific browser chrome tests
BROWSER_CHROME_MANIFESTS += ['test/browser.ini']